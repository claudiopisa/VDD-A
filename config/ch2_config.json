{
    "component_roots": ["NSPC"],
    "allowed_extensions": [".c", ".h", ".ads", ".adb", ".asm", ".s"],

    "rules": {
        "exclusion":{
          "dirs": ["Protocols_win32", ".vscode", "BIN", "INCMAKE", "MakeBatches", "SWIXL", "LIB", "EXE", "OBJ", "DEPS"],
          "dirs_contains": ["AdaTask"],
          "files": ["resource.h", "Loader.c", "boot.asm", "bootAP.asm"],
          "path_ext_blacklist": [
            { "path_contains": "SONS-RTS", "extensions": [".ads", ".adb"] }
          ]    
        },
        "inclusion":{
          "extensions": [".c", ".h", ".ads", ".adb", ".asm", ".s"]
        }
    },

    "version_extraction_criteria": "(?:\\\\*|//|--|;|#).*Version\\s*:?\\s*(\\d+\\.\\d+)",

    "mode": "version",
    "metadata": {
      "title": "LIST OF WSPHS+ SW FILES AND RELEVANT VERSIONS",
      "columns_name" : ["File name", "File version"]
    }
}